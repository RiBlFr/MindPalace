/* =======================================================
   复习计划看板 ScheduleCalendarDialog 美化样式
======================================================= */
QDialog#scheduleCalendar {
    background: #f7f8fb;
}

QLabel#calendarTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1f2937;
}

QLabel#calendarHint {
    font-size: 12px;
    color: #6b7280;
}

/* ---- 日历整体容器 ---- */
QCalendarWidget#calendarView {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

/* ---- 顶部导航栏 ---- */
QCalendarWidget#calendarView QWidget#qt_calendar_navigationbar {
    background-color: #5688b8;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    min-height: 48px;
}

/* 月份 / 年份 / 翻页箭头按钮 */
QCalendarWidget#calendarView QToolButton {
    color: #ffffff;
    background-color: transparent;
    border: none;
    margin: 7px 2px;
    padding: 4px 12px;
    font-size: 15px;
    font-weight: 600;
    icon-size: 18px;
}
QCalendarWidget#calendarView QToolButton:hover {
    background-color: rgba(255, 255, 255, 45);
    border-radius: 8px;
}
QCalendarWidget#calendarView QToolButton:pressed {
    background-color: rgba(255, 255, 255, 75);
    border-radius: 8px;
}
QCalendarWidget#calendarView QToolButton::menu-indicator {
    image: none;
}

/* 年份编辑框（点击年份后出现） */
QCalendarWidget#calendarView QSpinBox {
    color: #1f2937;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 2px 6px;
    selection-background-color: #5688b8;
    selection-color: #ffffff;
}

/* ---- 星期表头 ---- */
QCalendarWidget#calendarView QHeaderView::section {
    background: #ffffff;
    color: #94a3b8;
    padding: 8px 0;
    border: none;
    font-size: 12px;
    font-weight: 600;
}

/* ---- 日期网格视图 ---- */
QCalendarWidget#calendarView QAbstractItemView {
    outline: none;
    background: #ffffff;
    border: none;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    color: #334155;
    font-size: 13px;
    selection-background-color: transparent;
    selection-color: #334155;
}

/* =======================================================
   Dark calendar board
======================================================= */
QDialog#scheduleCalendar[theme="dark"] {
    background: #050910;
    color: #e8eef8;
}

QDialog#scheduleCalendar[theme="dark"] QLabel#calendarTitle {
    color: #f4f8ff;
    font-size: 22px;
    font-weight: 800;
}

QDialog#scheduleCalendar[theme="dark"] QLabel#calendarHint {
    color: #aeb8c8;
    font-size: 13px;
}

QCalendarWidget#calendarView[theme="dark"] {
    background-color: #07101b;
    border: 1px solid #2a95ff;
    border-radius: 18px;
}

QCalendarWidget#calendarView[theme="dark"] QWidget#qt_calendar_navigationbar {
    background-color: #08111d;
    border: 1px solid rgba(42, 149, 255, 110);
    border-bottom: none;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    min-height: 64px;
}

QCalendarWidget#calendarView[theme="dark"] QToolButton {
    color: #e8eef8;
    background-color: transparent;
    border: none;
    margin: 10px 18px;
    padding: 4px 16px;
    font-size: 16px;
    font-weight: 800;
    icon-size: 24px;
}

QCalendarWidget#calendarView[theme="dark"] QToolButton:hover {
    background-color: rgba(42, 149, 255, 38);
    border-radius: 10px;
}

QCalendarWidget#calendarView[theme="dark"] QToolButton:pressed {
    background-color: rgba(42, 149, 255, 70);
    border-radius: 10px;
}

QCalendarWidget#calendarView[theme="dark"] QToolButton::menu-indicator {
    image: none;
}

QCalendarWidget#calendarView[theme="dark"] QSpinBox {
    color: #e8eef8;
    background: #0d1724;
    border: 1px solid rgba(74, 163, 255, 150);
    border-radius: 8px;
    padding: 3px 8px;
    selection-background-color: #2a95ff;
    selection-color: #ffffff;
}

QCalendarWidget#calendarView[theme="dark"] QHeaderView::section {
    background-color: #09121d;
    color: #dce6f5;
    padding: 16px 0;
    border: 1px solid rgba(42, 149, 255, 92);
    font-size: 14px;
    font-weight: 700;
}

QCalendarWidget#calendarView[theme="dark"] QAbstractItemView {
    outline: none;
    background-color: #07101b;
    border: 1px solid rgba(42, 149, 255, 95);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    color: #e8eef8;
    font-size: 14px;
    selection-background-color: transparent;
    selection-color: #e8eef8;
}

QDialog#scheduleCalendar[theme="dark"] QMenu {
    background-color: #0a121e;
    border: 1px solid rgba(72, 96, 126, 180);
    border-radius: 8px;
    padding: 6px;
}

QDialog#scheduleCalendar[theme="dark"] QMenu::item {
    padding: 7px 28px 7px 16px;
    border-radius: 5px;
    color: #dce6f5;
}

QDialog#scheduleCalendar[theme="dark"] QMenu::item:selected {
    background-color: rgba(42, 149, 255, 62);
    color: #ffffff;
}
