/* =======================================================
   【极光毛玻璃模式】 Theme Aurora
======================================================= */
/* 1. 全局极光渐变背景 */
#mainWindowRoot {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #e0c3fc, stop:1 #8ec5fc);
}
/* 侧边栏与中央区透明度 */
QWidget[panel="side"] { background-color: rgba(243, 246, 250, 150); }
#centerPanel { background-color: transparent; }

/* 2. 顶部菜单栏 */
QMenuBar { background-color: transparent; border-bottom: 1px solid rgba(255, 255, 255, 80); }
QMenuBar::item { padding: 8px 12px; margin: 4px 2px; border-radius: 6px; color: #1f2937; background: transparent;}
QMenuBar::item:selected { background: rgba(255, 255, 255, 100); }
QMenu { background-color: rgba(255, 255, 255, 220); border: 1px solid rgba(255, 255, 255, 200); border-radius: 8px; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 4px; color: #1f2937; }
QMenu::item:selected { background-color: rgba(139, 117, 250, 40); color: #8B75FA; }

/* 3. 左侧卡组列表 */
QListWidget#deckList { background-color: rgba(255, 255, 255, 140); border: 1px solid rgba(255, 255, 255, 200); border-radius: 12px; padding: 6px; outline: none; }
QListWidget#deckList::item { padding: 10px 12px; margin: 2px; border-radius: 8px; color: #334155; }
QListWidget#deckList::item:hover { background: rgba(255, 255, 255, 180); color: #8B75FA; }
QListWidget#deckList::item:selected { background: #8B75FA; color: #ffffff; }

/* 4. 右侧进度条 */
QProgressBar#dailyProgress { height: 18px; border: 1px solid rgba(255, 255, 255, 150); border-radius: 9px; background: rgba(255, 255, 255, 120); text-align: center; color: #334155; font-size: 11px; font-weight: bold; }
QProgressBar#dailyProgress::chunk { border-radius: 8px; background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #9B88FA, stop:1 #8B75FA); }

/* 5. 通用按钮 */
QPushButton { outline: none; }

/* 所有操作按钮统一为「四个难度按钮」的玻璃拟态风格：
   半透明白底 + 白色细边 + 强调色底边；hover 提亮，pressed 填充强调色。 */
#btnAddDeck, #btnCalendar, #btnDeleteDeck, #btnResetDeck, #btnShowAnswer,
#btnForget, #btnHard, #btnNormal, #btnEasy {
    background-color: rgba(255, 255, 255, 140);
    border: 1.5px solid rgba(255, 255, 255, 220);
    border-radius: 12px;
    font-weight: bold;
}
#btnAddDeck:hover, #btnCalendar:hover, #btnDeleteDeck:hover, #btnResetDeck:hover, #btnShowAnswer:hover,
#btnForget:hover, #btnHard:hover, #btnNormal:hover, #btnEasy:hover {
    background-color: rgba(255, 255, 255, 220);
}
#btnAddDeck:pressed, #btnCalendar:pressed, #btnDeleteDeck:pressed, #btnResetDeck:pressed, #btnShowAnswer:pressed,
#btnForget:pressed, #btnHard:pressed, #btnNormal:pressed, #btnEasy:pressed {
    color: white;
    border: none;
    padding-top: 2px;
}

/* 各按钮的强调色（文字 + 底边 + hover 描边 + pressed 填充） */
#btnAddDeck { color: #8B75FA; border-bottom: 2px solid #8B75FA; }
#btnAddDeck:hover { border-color: #8B75FA; }
#btnAddDeck:pressed { background-color: #8B75FA; }

#btnCalendar { color: #638BFA; border-bottom: 2px solid #638BFA; }
#btnCalendar:hover { border-color: #638BFA; }
#btnCalendar:pressed { background-color: #638BFA; }

#btnDeleteDeck { color: #F43F5E; border-bottom: 2px solid #F43F5E; }
#btnDeleteDeck:hover { border-color: #F43F5E; }
#btnDeleteDeck:pressed { background-color: #F43F5E; }

#btnResetDeck { color: #F59E0B; border-bottom: 2px solid #F59E0B; }
#btnResetDeck:hover { border-color: #F59E0B; }
#btnResetDeck:pressed { background-color: #F59E0B; }

#btnShowAnswer { color: #8B75FA; border-bottom: 2px solid #8B75FA; }
#btnShowAnswer:hover { border-color: #8B75FA; }
#btnShowAnswer:pressed { background-color: #8B75FA; }

#btnForget { color: #F43F5E; border-bottom: 2px solid #F43F5E; }
#btnForget:hover { border-color: #F43F5E; }
#btnForget:pressed { background-color: #F43F5E; }

#btnHard { color: #F59E0B; border-bottom: 2px solid #F59E0B; }
#btnHard:hover { border-color: #F59E0B; }
#btnHard:pressed { background-color: #F59E0B; }

#btnNormal { color: #8B75FA; border-bottom: 2px solid #8B75FA; }
#btnNormal:hover { border-color: #8B75FA; }
#btnNormal:pressed { background-color: #8B75FA; }

#btnEasy { color: #10B981; border-bottom: 2px solid #10B981; }
#btnEasy:hover { border-color: #10B981; }
#btnEasy:pressed { background-color: #10B981; }