/* =======================================================
   Dark Theme
======================================================= */

#mainWindowRoot {
    background-color: #050910;
}

QMainWindow {
    background-color: #050910;
    color: #e8eef8;
}

QWidget {
    color: #dce6f5;
}

#centerPanel {
    background-color: #07101b;
    border: 1px solid rgba(67, 90, 118, 130);
    border-radius: 12px;
}

QWidget[panel="side"] {
    background-color: #050910;
}

QLabel {
    color: #e8eef8;
}

QMenuBar {
    background-color: #080d15;
    border-bottom: 1px solid rgba(55, 71, 94, 150);
}

QMenuBar::item {
    padding: 8px 12px;
    margin: 5px 2px;
    border-radius: 6px;
    color: #d5deea;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: rgba(47, 132, 255, 42);
    color: #ffffff;
}

QMenu {
    background-color: #0a121e;
    border: 1px solid rgba(72, 96, 126, 180);
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 16px;
    border-radius: 5px;
    color: #d5deea;
}

QMenu::item:selected {
    background-color: rgba(48, 144, 255, 62);
    color: #ffffff;
}

QListWidget#deckList {
    background-color: rgba(8, 15, 26, 235);
    border: 1px solid rgba(72, 96, 126, 150);
    border-radius: 12px;
    padding: 10px;
    outline: none;
    color: #dce6f5;
}

QListWidget#deckList::item {
    min-height: 40px;
    padding: 10px 14px;
    margin: 4px 2px;
    border-radius: 8px;
    color: #dce6f5;
}

QListWidget#deckList::item:hover {
    background-color: rgba(30, 91, 178, 95);
    color: #ffffff;
}

QListWidget#deckList::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0b4a93, stop:1 #122a6b);
    border: 1px solid #2897ff;
    color: #ffffff;
}

QFrame[role="surface"] {
    background-color: rgba(11, 18, 30, 225);
    border: 1px solid rgba(72, 96, 126, 150);
    border-radius: 12px;
}

QProgressBar#dailyProgress {
    min-height: 18px;
    max-height: 18px;
    border: 1px solid rgba(121, 143, 175, 120);
    border-radius: 9px;
    background-color: #1a2432;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
}

QProgressBar#dailyProgress::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2a95ff, stop:1 #7c56ff);
}

QPushButton {
    outline: none;
    min-height: 36px;
    border-radius: 8px;
    font-weight: 700;
    color: #dfe9f8;
    background-color: rgba(12, 24, 42, 220);
    border: 1px solid rgba(55, 147, 255, 190);
}

QPushButton:hover {
    color: #ffffff;
}

QPushButton:pressed {
    padding-top: 2px;
}

QPushButton:disabled {
    color: rgba(223, 233, 248, 125);
}

#btnAddDeck, #btnShowAnswer {
    color: #eaf4ff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(8, 47, 105, 225),
                                stop:1 rgba(16, 38, 91, 230));
    border: 1px solid #248dff;
}

#btnAddDeck:hover, #btnShowAnswer:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(13, 67, 141, 235),
                                stop:1 rgba(23, 51, 116, 240));
}

#btnCheckIn {
    min-height: 30px;
    color: #75ffd0;
    background-color: rgba(10, 66, 55, 190);
    border: 1px solid rgba(58, 224, 178, 165);
    border-radius: 8px;
}

#btnCheckIn:hover {
    background-color: rgba(13, 88, 72, 215);
}

#btnCheckIn:disabled {
    color: #79ffd2;
    background-color: rgba(10, 66, 55, 190);
    border: 1px solid rgba(58, 224, 178, 165);
}

#btnCalendar {
    color: #9ff7ff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(0, 90, 97, 210),
                                stop:1 rgba(7, 70, 84, 225));
    border: 1px solid #12d8df;
}

#btnDeleteDeck {
    color: #ffccd6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(105, 13, 37, 225),
                                stop:1 rgba(70, 15, 32, 225));
    border: 1px solid #ff4568;
}

#btnResetDeck {
    color: #ffdca3;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(112, 67, 4, 225),
                                stop:1 rgba(78, 48, 7, 225));
    border: 1px solid #ff9f1a;
}

#btnForget, #btnHard, #btnNormal, #btnEasy {
    border-radius: 10px;
    min-height: 60px;
}

#btnForget {
    color: #ffd0d8;
    border-color: #ff4568;
    background-color: rgba(95, 17, 37, 210);
}

#btnHard {
    color: #ffe2ae;
    border-color: #ff9f1a;
    background-color: rgba(93, 55, 7, 210);
}

#btnNormal {
    color: #e8dcff;
    border-color: #7c56ff;
    background-color: rgba(45, 30, 91, 210);
}

#btnEasy {
    color: #c9ffe9;
    border-color: #31e1aa;
    background-color: rgba(7, 74, 56, 210);
}
